# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# CALL-E: Required for BidPilot Voice supplier/provider verification calls.
# Create a key in the CALL-E dashboard and keep it server-side only.
CALLE_API_KEY=""
CALLE_BASE_URL="https://api.heycall-e.com"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Separate private operator token (at least 24 random characters); never the API key.
CALLE_OPERATOR_TOKEN=""
# One consenting test number in E.164 format. Empty disables calls.
CALLE_ALLOWED_PHONES=""
